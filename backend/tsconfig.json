{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "app/common": [
        "libs/common/src"
      ],
      "app/common/*": [
        "libs/common/src/*"
      ],
      "app/database": [
        "libs/database/src"
      ],
      "app/database/*": [
        "libs/database/src/*"
      ],
      "app/domain": [
        "libs/domain/src"
      ],
      "app/domain/*": [
        "libs/domain/src/*"
      ],
      "app/messaging": [
        "libs/messaging/src"
      ],
      "app/messaging/*": [
        "libs/messaging/src/*"
      ],
      "app/providers": [
        "libs/providers/src"
      ],
      "app/providers/*": [
        "libs/providers/src/*"
      ]
    }
  }
}